# Copy this file to .env and fill in your own values. .env is git-ignored.

# Anthropic API key used by the QA agents (and by BookNest's "Ask the Librarian" feature).
ANTHROPIC_API_KEY=

# Where the BookNest system under test is running.
BOOKNEST_URL=http://127.0.0.1:8000

# Secret used to sign JWT access tokens (HS256). If unset, a random key is generated per process.
BOOKNEST_JWT_SECRET=
# Access token lifetime in minutes (default 60).
BOOKNEST_JWT_TTL_MINUTES=60
